RewriteEngine On
RewriteBase /

# Sin listado de directorios.
Options -Indexes

# Nunca servir dumps ni secretos del paquete de despliegue.
<FilesMatch "(^\.env|\.(sql|log)$)">
  Require all denied
</FilesMatch>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/xml text/xml image/svg+xml font/woff2
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/xml text/xml image/svg+xml font/woff2
  </IfModule>
</IfModule>

<IfModule mod_headers.c>
  Header merge Vary Accept-Encoding
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
  <Files "manifest.webmanifest">
    Header set Cache-Control "public, max-age=86400"
  </Files>
  <Files "sitemap.xml">
    Header set Cache-Control "public, max-age=3600"
  </Files>
  # Genéricos primero (hashed: inmutables). Los ficheros de runtime sin hash van
  # DESPUÉS para que su "no-cache" gane: con Header set aplica el último.
  <FilesMatch "\.(js|css|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Imágenes fijas del sitio (/images, /assets...): nombre sin hash, así que el
  # navegador revalida en cada visita (ETag/Last-Modified -> 304 sin cuerpo).
  # Si se reemplaza un archivo con el mismo nombre, se ve al instante.
  # Las subidas del CMS (api/uploads) tienen nombre único: api/.htaccess las
  # marca como inmutables.
  <FilesMatch "\.(webp|jpe?g|png|gif|avif|svg|ico)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(br|gz)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Runtime del service worker: nombre fijo, nunca debe cachearse (si no, el SW
  # se queda viejo y sirve manifests obsoletos indefinidamente).
  <Files "ngsw.json">
    Header set Cache-Control "no-cache"
  </Files>
  <Files "ngsw-worker.js">
    Header set Cache-Control "no-cache"
  </Files>
  <Files "safety-worker.js">
    Header set Cache-Control "no-cache"
  </Files>
  <Files "worker-basic.min.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

RewriteRule ^api/ - [L]
RewriteRule ^api\.php(?:/|$) - [L]
RewriteRule ^sitemap\.xml$ /api/sitemap.xml [L]
RewriteRule ^index\.html$ - [L]

# Precomprimidos generados por tools/build-cpanel.sh (.br primero, luego .gz).
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+\.(js|css|svg|html|json|xml|webmanifest|txt))$ $1.br [L]
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+\.(js|css|svg|html|json|xml|webmanifest|txt))$ $1.gz [L]
</IfModule>
<IfModule mod_mime.c>
  AddEncoding br .br
  AddEncoding gzip .gz
</IfModule>

# El optimizador renombró estos .png a .jpg; el contenido guardado en la BD
# todavía apunta al nombre viejo. Redirección permanente, no un 404.
RewriteRule ^(ServidoresHPE|windows|windows-server-azure-arc)\.png$ /$1.jpg [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(jpe?g|png|gif|webp|svg|ico|js|css|map|woff2?|ttf|eot|json|br|gz)$ [NC]
RewriteRule . /index.html [L]
