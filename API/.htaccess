RewriteEngine On
RewriteBase /api/

# Sin listado de directorios.
Options -Indexes

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml text/xml image/svg+xml
  </IfModule>
</IfModule>
<IfModule mod_headers.c>
  Header merge Vary Accept-Encoding
  # Subidas del CMS: cada archivo (y cada recorte) recibe un nombre aleatorio
  # nuevo, nunca se sobrescribe; se pueden guardar un año sin revalidar.
  # Este .htaccess es más específico que el de la raíz, así que gana sobre su
  # regla "no-cache" para imágenes.
  <FilesMatch "\.(webp|jpe?g|png|gif|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<Files ".env">
  Require all denied
</Files>
<FilesMatch "\.(sql|md|log)$">
  Require all denied
</FilesMatch>

RewriteRule ^tests/ - [F]
RewriteRule ^vendor/ - [F]
RewriteRule ^tmp/ - [F]
RewriteRule ^uploads/.*\.(php|phtml|phar)$ - [F]
RewriteRule ^(schema\.sql|composer\.(json|lock)|Dockerfile|entrypoint\.sh|router\.php)$ - [F]

# Solo index.php atiende directo; el resto de planos solo vía router (evita bypass de rate-limit/CORS).
RewriteCond %{REQUEST_URI} !/index\.php$
RewriteRule ^[A-Za-z0-9_-]+\.php$ - [F]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^uploads/ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
