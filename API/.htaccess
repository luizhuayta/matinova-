RewriteEngine On
RewriteBase /api/

<Files ".env">
  Require all denied
</Files>
<FilesMatch "\.(sql|md|log)$">
  Require all denied
</FilesMatch>

RewriteRule ^tests/ - [F]
RewriteRule ^vendor/ - [F]
RewriteRule ^tmp/ - [F]
RewriteRule ^uploads/.*\.(php|phtml|phar)$ - [F]
RewriteRule ^(schema\.sql|composer\.(json|lock)|Dockerfile|entrypoint\.sh|router\.php)$ - [F]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^uploads/ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
