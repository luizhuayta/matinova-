# Copia este archivo a API/.env para local o Cursor Cloud.
# docker compose ya inyecta estas mismas variables; el archivo sirve
# si la API corre fuera de Compose (PHP + MariaDB nativos).
# NO pongas aquí las claves de cPanel / producción.

APP_ORIGIN=http://127.0.0.1:4200
APP_DEBUG=1
APP_SETUP=0

ADMIN_USER=admin
ADMIN_PASSWORD=admin123
EDITOR_USER=editor
EDITOR_PASSWORD=editor123

# Base de datos — elige según cómo corras la API:
#   · Dentro de Compose (docker/podman-compose): DB_HOST=db  DB_PORT=3306
#     DB_USER=matt  DB_PASSWORD=mattlocal
#   · PHP nativo contra la MariaDB de Compose:   DB_HOST=127.0.0.1  DB_PORT=3307
#   · PHP nativo contra una MariaDB local:       DB_HOST=127.0.0.1  DB_PORT=3306
#     con el usuario/clave que hayas creado (en local puede ser root sin clave).
DB_HOST=db
DB_PORT=3306
DB_NAME=mattinnova_cms
DB_USER=matt
DB_PASSWORD=mattlocal

SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notificaciones@mattinnovasolution.com
SMTP_FROM_NAME=Matt Innova Solution
CONTACT_DEST_EMAIL=
CLAIMS_DEST_EMAIL=
